# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5001                                 # Port the Fastify server listens on
HOST=127.0.0.1                            # Bind address (use 0.0.0.0 in containers)
NODE_ENV=development                      # development | production
LOG_LEVEL=info                            # fatal | error | warn | info | debug | trace
CORS_WHITE_LIST=http://localhost:5173     # Allowed origins in production, separated by ";"

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=100                        # Requests per window, all routes
RATE_LIMIT_TIME_WINDOW=1 minute           # Rate limit window
CHAT_RATE_LIMIT_MAX=20                    # Requests per window for POST /api/chat
MAX_HISTORY_MESSAGES=40                   # Max messages accepted per chat request
MAX_MESSAGE_LENGTH=8000                   # Max characters per message
MAX_OUTPUT_TOKENS=4096                    # Upper bound for max_tokens
REQUEST_TIMEOUT_MS=120000                 # Abort an upstream call after this long
SYSTEM_PROMPT=                            # Optional override of the default system prompt

# ---------------------------------------------------------------------------
# Providers -- a provider shows up in GET /api/providers only when its key is set.
# MODELS variables are optional, comma separated, first entry is the default.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

DEEP_SEEK_API_KEY=
DEEP_SEEK_BASE_URL=https://api.deepseek.com
DEEP_SEEK_MODELS=deepseek-chat,deepseek-reasoner

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o-mini,gpt-4o
